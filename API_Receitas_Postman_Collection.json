    {
      "name": "1. Fluxo de Sucesso (CRUD Completo)",
      "item": [
        {
          "name": "1.1 Criar Receita #1 (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Bolo de Cenoura com Cobertura de Chocolate\",\n  \"duracaoDoPreparoMinutos\": 67.0,\n  \"ingredientes\": [\n    \"3 cenouras médias\",\n    \"4 ovos\",\n    \"2 xícaras de açúcar\",\n    \"2 e 1/2 xícaras de farinha de trigo\",\n    \"1 colher de sopa de fermento em pó\"\n  ],\n  \"tutorialPreparo\": \"Bata as cenouras, os ovos e o óleo no liquidificador, misture os secos e asse a 180°C por 40 minutos.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/receitas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "receitas"
              ]
            }
          }
        },
        {
          "name": "1.2 Criar Receita #2 para testes de listagem e paginação (201 Created)",
          "request": {
            "method": "POST",
            "header": [
