              "raw": "{\n  \"nome\": \"Lasanha à Bolonhesa\",\n  \"duracaoDoPreparoMinutos\": 90.0,\n  \"ingredientes\": [\n    \"500g de massa para lasanha\",\n    \"500g de carne moída\",\n    \"2 sachês de molho de tomate\",\n    \"300g de queijo mussarela\",\n    \"300g de presunto\"\n  ],\n  \"tutorialPreparo\": \"Monte camadas alternadas de molho, massa, presunto e queijo. Leve ao forno por 30 minutos.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/receitas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "receitas"
              ]
            }
          }
