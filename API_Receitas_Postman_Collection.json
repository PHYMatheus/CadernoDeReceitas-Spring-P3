              "raw": "{\n  \"nome\": \"Bolo de Cenoura Especial de Brigaderia\",\n  \"duracaoDoPreparoMinutos\": 65.0,\n  \"ingredientes\": [\n    \"3 cenouras médias\",\n    \"4 ovos\",\n    \"2 xícaras de açúcar\",\n    \"2 e 1/2 xícaras de farinha de trigo\",\n    \"1 lata de leite condensado\",\n    \"200g de chocolate meio amargo\"\n  ],\n  \"tutorialPreparo\": \"Prepare a massa tradicional e finalize cobrindo com brigadeiro cremoso meio amargo.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/receitas/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "receitas",
                "1"
              ]
            }
          }
        },
        {
